# ── Hardhat-only build ─────────────────────────────────────────────────────
# Nothing here is required: the defaults work with `npx hardhat node`.

# Local Hardhat node (default shown)
RPC_URL=http://127.0.0.1:8545

# Where image links point (the API itself serves stored images)
PUBLIC_API_URL=http://localhost:8000

# "local" = keep images on disk, no internet needed (default)
# "auto"  = also pin to IPFS via Pinata when PINATA_JWT is set
STORAGE_MODE=local
# PINATA_JWT=

# Optional: fixed JWT secret (otherwise a random one is saved in data/)
# JWT_SECRET=

# Optional: email notifications (otherwise emails are skipped with a log line)
# GMAIL_ADDRESS=
# GMAIL_APP_PASSWORD=
